# Scrip public distribution site. Local agent APIs are never proxied here.
__SCRIP_HOSTNAME__ {
    root * /srv/scrip-web/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
        Cache-Control "no-cache"
    }
    @artifacts path /downloads/*.exe /downloads/*.whl
    header @artifacts Cache-Control "public, max-age=31536000, immutable"
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
